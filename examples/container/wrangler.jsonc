{
  "name": "libcf-container",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "durable_objects": { "bindings": [{ "name": "OBJECTS", "class_name": "Inspection" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inspection"] }],
  "containers": [{ "class_name": "Inspection", "image": "replace-with-approved-image", "instance_type": "lite", "max_instances": 1 }]
}
