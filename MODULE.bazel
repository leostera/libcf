module(
    name = "cf",
    version = "0.1.0",
    bazel_compatibility = [">=9.3.0", "<9.3.1"],
)

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "emsdk", version = "6.0.12")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

# Pin the runtime and archive hashes rather than using the rules' default Node.
# Supported development hosts: macOS/Linux, arm64/x86_64.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_version = "26.11.1",
    node_repositories = {
        "26.11.1-darwin_arm64": [
            "node-v26.11.1-darwin-arm64.tar.gz",
            "node-v26.11.1-darwin-arm64",
            "d916511b55965e91be7a88e17f88d895b6793ceaba3e6c9b194aefe51c2c65ac",
        ],
        "26.11.1-darwin_amd64": [
            "node-v26.11.1-darwin-x64.tar.gz",
            "node-v26.11.1-darwin-x64",
            "9a8129bd9ab08039793dd1143a7aedee6b5d60ac06592ad938d8bddf36142f3a",
        ],
        "26.11.1-linux_arm64": [
            "node-v26.11.1-linux-arm64.tar.xz",
            "node-v26.11.1-linux-arm64",
            "0945e2cde6aa0f54d980f03874dfe5cf3a549ce714c7fb9019e591ce0accf282",
        ],
        "26.11.1-linux_amd64": [
            "node-v26.11.1-linux-x64.tar.xz",
            "node-v26.11.1-linux-x64",
            "3883bfc73f9a680ca4eab04b196068aaaab1373ffa77d8fc1a4408222495b651",
        ],
    },
)
use_repo(node, "nodejs", "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.22.0",
    pnpm_version_integrity = "sha512-vwSe/plbKPUn/StBrgR0zikYb37cs79UUIe9Yfu+uyv3U2LRMH/aCcLSiOHkmXh6wS1Py2F6l0cYpgUfLu50HA==",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    data = ["//:pnpm-workspace.yaml"],
)
use_repo(npm, "npm")
