module(
    name = "cf",
    version = "0.1.0",
    bazel_compatibility = [">=9.3.0", "<9.3.1"],
)

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_pkg", version = "1.3.0", dev_dependency = True)
bazel_dep(name = "rules_python", version = "1.8.4", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "emsdk", version = "6.0.12")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

# Pin the runtime and archive hashes rather than using the rules' default Node.
# Supported development hosts: macOS/Linux, arm64/x86_64.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_version = "26.11.1",
    node_repositories = {
        "26.11.1-darwin_arm64": [
            "node-v26.11.1-darwin-arm64.tar.gz",
            "node-v26.11.1-darwin-arm64",
            "d916511b55965e91be7a88e17f88d895b6793ceaba3e6c9b194aefe51c2c65ac",
        ],
        "26.11.1-darwin_amd64": [
            "node-v26.11.1-darwin-x64.tar.gz",
            "node-v26.11.1-darwin-x64",
            "9a8129bd9ab08039793dd1143a7aedee6b5d60ac06592ad938d8bddf36142f3a",
        ],
        "26.11.1-linux_arm64": [
            "node-v26.11.1-linux-arm64.tar.xz",
            "node-v26.11.1-linux-arm64",
            "0945e2cde6aa0f54d980f03874dfe5cf3a549ce714c7fb9019e591ce0accf282",
        ],
        "26.11.1-linux_amd64": [
            "node-v26.11.1-linux-x64.tar.xz",
            "node-v26.11.1-linux-x64",
            "3883bfc73f9a680ca4eab04b196068aaaab1373ffa77d8fc1a4408222495b651",
        ],
    },
)
use_repo(node, "nodejs", "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.22.0",
    pnpm_version_integrity = "sha512-vwSe/plbKPUn/StBrgR0zikYb37cs79UUIe9Yfu+uyv3U2LRMH/aCcLSiOHkmXh6wS1Py2F6l0cYpgUfLu50HA==",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    data = ["//:pnpm-workspace.yaml"],
)
use_repo(npm, "npm")

# workers-rs benchmark comparator (development only). Versions mirror
# worker-build 0.8.7: wasm-bindgen 0.2.129 (Cargo.lock) and binaryen 132.
bazel_dep(name = "rules_rust", version = "0.74.0", dev_dependency = True)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    extra_target_triples = ["wasm32-unknown-unknown"],
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all", dev_dependency = True)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate", dev_dependency = True)
crate.from_cargo(
    name = "rust_bench_crates",
    cargo_lockfile = "//bench/rust:Cargo.lock",
    manifests = ["//bench/rust:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
    ],
)
use_repo(crate, "rust_bench_crates")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_TOOL_BUILD = """exports_files(glob(["**"]))
filegroup(name = "all", srcs = glob(["**"]), visibility = ["//visibility:public"])
"""

http_archive(
    name = "wasm_bindgen_cli_darwin_arm64",
    build_file_content = _TOOL_BUILD,
    dev_dependency = True,
    sha256 = "81d4a23d56b3c3eb8187658329116d50e0b228a93b343825fb71f70179051cd1",
    strip_prefix = "wasm-bindgen-0.2.129-aarch64-apple-darwin",
    urls = ["https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.129/wasm-bindgen-0.2.129-aarch64-apple-darwin.tar.gz"],
)

http_archive(
    name = "wasm_bindgen_cli_linux_amd64",
    build_file_content = _TOOL_BUILD,
    dev_dependency = True,
    sha256 = "82d12bb940e2d4e72e0d5605387fc1b8ca179044e012b620f0ce4e7440e8320e",
    strip_prefix = "wasm-bindgen-0.2.129-x86_64-unknown-linux-musl",
    urls = ["https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.129/wasm-bindgen-0.2.129-x86_64-unknown-linux-musl.tar.gz"],
)

http_archive(
    name = "binaryen_darwin_arm64",
    build_file_content = _TOOL_BUILD,
    dev_dependency = True,
    sha256 = "98aad827847af7ef990ed7098d885725c8e5b5aae75073403635617ae4e259aa",
    strip_prefix = "binaryen-version_132",
    urls = ["https://github.com/WebAssembly/binaryen/releases/download/version_132/binaryen-version_132-arm64-macos.tar.gz"],
)

http_archive(
    name = "binaryen_linux_amd64",
    build_file_content = _TOOL_BUILD,
    dev_dependency = True,
    sha256 = "195ddc94f9bc89f45abdabb0b9eea86023d727ba90eac8b35b80f2544fc30572",
    strip_prefix = "binaryen-version_132",
    urls = ["https://github.com/WebAssembly/binaryen/releases/download/version_132/binaryen-version_132-x86_64-linux.tar.gz"],
)
