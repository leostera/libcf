{
  "name": "libcf",
  "private": true,
  "type": "module",
  "scripts": {
    "build:spike": "node scripts/build-spike.mjs",
    "build:core": "node scripts/build-core.mjs",
    "test:native": "cmake -S . -B build/native -DCMAKE_BUILD_TYPE=Debug && cmake --build build/native && ctest --test-dir build/native --output-on-failure",
    "test:core": "npm run build:core && node --test examples/core/test/*.test.mjs",
    "test:spike": "npm run build:spike && node --test examples/hello/test/*.test.mjs",
    "bench:spike": "npm run build:spike && node scripts/bench-spike.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  }
}
