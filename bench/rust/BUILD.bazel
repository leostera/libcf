load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("@rust_bench_crates//:defs.bzl", "all_crate_deps")

exports_files(["Cargo.toml", "Cargo.lock"])

# Source fingerprint inputs for the benchmark runner.
js_library(
    name = "sources",
    srcs = ["BUILD.bazel", "Cargo.lock", "Cargo.toml", "src/kernels.rs", "src/lib.rs"],
    visibility = ["//visibility:public"],
)

rust_shared_library(
    name = "benchmark_rust_lib",
    srcs = ["src/kernels.rs", "src/lib.rs"],
    crate_name = "libcf_benchmark_rust",
    edition = "2021",
    # Explicit Wasm SIMD in the compute kernels, like the C++ fixture's -msimd128.
    rustc_flags = ["-Ctarget-feature=+simd128"],
    # compilation_mode=opt (set by rust_worker) gives Cargo's default release
    # profile, which the workers-rs templates use: opt-level 3, no LTO.
    target_compatible_with = ["@platforms//cpu:wasm32"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
