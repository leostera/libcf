load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools:worker.bzl", "bridge_spike", "cf_worker")
load("//tools:sdk.bzl", "cf_sdk")

npm_link_all_packages(name = "node_modules")

cf_sdk()

pkg_files(
    name = "sdk_files",
    srcs = glob(["include/cf/**/*.hpp", "lib/*.mjs", "lib/*.js"]) + [
        "src/worker.cpp", "MODULE.bazel", "MODULE.bazel.lock", ".bazelversion",
        "pnpm-lock.yaml", "pnpm-workspace.yaml", "REPO.bazel",
        "//tools:BUILD.bazel", "//tools:sdk.bzl", "//tools:worker.bzl",
        "packaging/BUILD.sdk.bazel", "packaging/package.json", "docs/packaging.md",
    ],
    strip_prefix = strip_prefix.from_root(""),
    renames = {
        "packaging/BUILD.sdk.bazel": "BUILD.bazel",
        "packaging/package.json": "package.json",
        "docs/packaging.md": "README.md",
    },
)

pkg_tar(
    name = "sdk_archive",
    srcs = [":sdk_files"],
    out = "cf-0.1.0.tar.gz",
    package_dir = "cf-0.1.0",
    extension = "tar.gz",
    mode = "0644",
    owner = "0.0",
    mtime = 0,
    portable_mtime = False,
    stamp = 0,
)

py_binary(
    name = "unpack_sdk",
    srcs = ["scripts/unpack-sdk.py"],
    main = "scripts/unpack-sdk.py",
)

SDK_CHECK_DATA = [
    ":sdk_archive", ":unpack_sdk", ":runtime_modules", ":node_modules/esbuild",
    "scripts/sdk-archive.mjs", "src/worker.cpp", "tests/package/all_headers.cpp",
] + glob(["include/cf/**/*.hpp"])

js_test(
    name = "sdk_archive_test",
    entry_point = "tests/toolchains/package.mjs",
    args = ["$(rootpath :unpack_sdk)"],
    data = SDK_CHECK_DATA,
)

js_binary(
    name = "verify_package",
    entry_point = "scripts/verify-package.mjs",
    args = ["$(rootpath :unpack_sdk)"],
    data = SDK_CHECK_DATA + [
        ":node_modules/miniflare", "tests/package/main.cpp",
        "tests/package/consumer-worker.cpp", "tests/package/BUILD.consumer",
    ],
    tags = ["manual"],
)

EXAMPLES = [
    "core", "kv", "d1", "r2", "cache", "service", "durable", "events",
    "websocket", "email", "rate-limit", "analytics", "metadata", "worker-loader",
    "crypto", "benchmark", "http-client", "pipeline", "timer", "workflow",
    "images", "clock", "rpc", "ai", "service-tcp", "vectorize", "dispatch", "media", "ai-search", "stream", "browser", "agent-memory", "container", "flagship", "artifacts", "analytics-sql", "ai-gateway", "legacy-sites", "outbound-https",
]

[cf_worker(name = name, srcs = ["examples/%s/src/main.cpp" % name]) for name in EXAMPLES]
cf_worker(name = "durable-object", srcs = ["examples/durable/src/object.cpp"])
bridge_spike(name = "spike")
cf_worker(name = "stream-lifecycle-probe", srcs = ["tests/stream-lifecycle/main.cpp"], cxx_standard = 23)

filegroup(
    name = "all_workers",
    srcs = [":" + name for name in EXAMPLES] + [":durable-object", ":spike", ":stream-lifecycle-probe"],
)

js_binary(
    name = "bundle_tool",
    entry_point = "scripts/bundle-worker.mjs",
    data = [":node_modules/esbuild"],
)

[js_run_binary(
    name = name + "_bundle",
    tool = ":bundle_tool",
    srcs = ["examples/%s/worker.mjs" % name, ":runtime_modules", ":" + name] +
           ([":durable-object"] if name == "durable" else []),
    args = ["examples/%s/worker.mjs" % name, "bundles/" + name],
    out_dirs = ["bundles/" + name],
) for name in EXAMPLES]

JS_ENTRIES = {
    "hello": "examples/hello/worker.mjs",
    "hello-js": "examples/hello/plain.mjs",
    "benchmark-js": "examples/benchmark/plain.mjs",
    "service-upstream": "examples/service/upstream/worker.mjs",
    "http-upstream": "examples/http-client/upstream/worker.mjs",
    "rpc-reference": "examples/rpc/reference/worker.mjs",
    "service-tcp-reference": "examples/service-tcp/reference/worker.mjs",
    "dispatch-reference": "examples/dispatch/reference/worker.mjs",
}

[js_run_binary(
    name = name + "_bundle",
    tool = ":bundle_tool",
    srcs = [entry] + ([":spike"] if name == "hello" else []),
    args = [entry, "bundles/" + name],
    out_dirs = ["bundles/" + name],
) for name, entry in JS_ENTRIES.items()]

js_run_binary(
    name = "stream-lifecycle-probe_bundle",
    tool = ":bundle_tool",
    srcs = ["tests/stream-lifecycle/worker.mjs", ":runtime_modules", ":stream-lifecycle-probe"],
    args = ["tests/stream-lifecycle/worker.mjs", "bundles/stream-lifecycle-probe"],
    out_dirs = ["bundles/stream-lifecycle-probe"],
)

filegroup(
    name = "all_bundles",
    srcs = [":" + name + "_bundle" for name in EXAMPLES + JS_ENTRIES.keys()] + [":stream-lifecycle-probe_bundle"],
)

js_test(
    name = "stream_lifecycle_local_test",
    entry_point = "tests/stream-lifecycle/worker.test.mjs",
    data = [":stream-lifecycle-probe_bundle", ":node_modules/miniflare"],
)

js_test(
    name = "bundles_test",
    entry_point = "tests/toolchains/bundles.mjs",
    data = [":all_bundles", ":node_modules/miniflare"],
)

filegroup(
    name = "example_sources",
    srcs = glob(["examples/**/*.mjs", "examples/**/*.jsonc", "examples/**/public/**", "examples/**/README.md"]),
)

js_test(
    name = "platform_contracts_test",
    entry_point = "tests/platform-contracts/test.mjs",
    data = [
        "tests/platform-contracts/fixture.ts",
        "tests/platform-contracts/reflection.mjs",
        "lib/image-rotate.mjs",
        "lib/analytics-sql.mjs",
        "lib/ai-gateway.mjs",
        "lib/sites.mjs",
        "lib/outbound-get.mjs",
        "lib/queue.mjs",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/typescript",
        ":node_modules/miniflare",
    ],
)

JS_TEST_DATA = [
    ":runtime_modules",
    ":example_sources",
    ":node_modules/esbuild",
    ":node_modules/jsonc-parser",
    ":node_modules/miniflare",
]

LOCAL_EXAMPLES = [name for name in EXAMPLES if name != "benchmark"] + ["hello"]

[js_test(
    name = name + "_local_test",
    entry_point = "examples/%s/test/worker.test.mjs" % name,
    data = JS_TEST_DATA + [":spike" if name == "hello" else ":" + name] +
           ([":durable-object"] if name == "durable" else []) +
           ([":" + name + "_bundle"] if name in ["legacy-sites", "images"] else []),
) for name in LOCAL_EXAMPLES]

filegroup(
    name = "js_test_inputs",
    srcs = ["INVENTORY.md"] + glob(["tests/*.test.mjs", "scripts/*.mjs", "include/cf/**/*.hpp", "docs/*.md"]),
)

JS_TEST_FILES = glob(
    ["tests/*.test.mjs"],
    exclude = ["tests/benchmark-integration.test.mjs"],
)

[js_test(
    name = "js_" + path.removeprefix("tests/").removesuffix(".test.mjs") + "_test",
    entry_point = path,
    data = JS_TEST_DATA + [":js_test_inputs"],
) for path in JS_TEST_FILES]

js_test(
    name = "benchmark_local_test",
    entry_point = "tests/benchmark-integration.test.mjs",
    data = JS_TEST_DATA + [":benchmark", ":js_test_inputs"],
)

js_binary(
    name = "prepare_live_worker",
    entry_point = "scripts/build-live-worker.mjs",
    data = JS_TEST_DATA + [":all_workers", "scripts/live-output.mjs"],
    tags = ["manual"],
)

js_binary(
    name = "prepare_cron_control",
    entry_point = "scripts/build-live-cron-control.mjs",
    data = JS_TEST_DATA + [":events", "scripts/live-output.mjs"],
    tags = ["manual"],
)

[js_binary(
    name = "live_" + path.removeprefix("scripts/test-live-").removesuffix(".mjs").replace("-", "_"),
    entry_point = path,
    data = [":runtime_modules", ":example_sources"] + glob(["scripts/*.mjs"]),
    tags = ["manual"],
) for path in glob(["scripts/test-live-*.mjs"])]

DEV_EXAMPLES = ["hello", "core", "kv", "d1", "r2", "cache", "service", "durable", "events"]

[js_binary(
    name = name + "_dev",
    entry_point = "scripts/dev-example.mjs",
    args = [name],
    data = JS_TEST_DATA + [":spike" if name == "hello" else ":" + name] +
           ([":durable-object"] if name == "durable" else []),
    tags = ["manual"],
) for name in DEV_EXAMPLES]

js_binary(
    name = "benchmark_spike",
    entry_point = "scripts/bench-spike.mjs",
    data = JS_TEST_DATA + [":spike"],
    tags = ["manual"],
)

js_binary(
    name = "benchmark_sdk",
    entry_point = "scripts/bench-sdk.mjs",
    data = JS_TEST_DATA + [
        ":benchmark", ":sdk_archive", "scripts/benchmark-support.mjs",
        "pnpm-lock.yaml", "MODULE.bazel", "MODULE.bazel.lock", "BUILD.bazel", ".bazelversion", ".bazelrc",
    ] + glob(["include/cf/**/*.hpp", "src/*.cpp", "examples/benchmark/src/*.cpp"]),
    tags = ["manual"],
)

test_suite(
    name = "local_tests",
    tests = [":" + name + "_local_test" for name in LOCAL_EXAMPLES] + [":benchmark_local_test"],
)

test_suite(
    name = "js_tests",
    tests = [":js_" + path.removeprefix("tests/").removesuffix(".test.mjs") + "_test" for path in JS_TEST_FILES],
)

NATIVE_SUITES = [
    "core", "storage", "d1", "events", "websocket", "email", "rate_limit",
    "analytics", "metadata", "worker_loader", "subtle_crypto", "http_client",
    "pipeline", "timer", "workflow", "images", "clock", "wire_limits", "rpc", "ai", "service_tcp", "vectorize", "dispatch", "media", "ai_search", "stream_video", "browser", "agent_memory", "container", "flagship", "artifacts", "analytics_sql", "ai_gateway", "sites", "outbound_http",
]

[cc_test(
    name = "native_%s_test" % name,
    srcs = ["tests/native/%s.cpp" % name],
    deps = [":cf"],
) for name in NATIVE_SUITES]

[cc_test(
    name = "headers_cxx%d_test" % standard,
    srcs = ["tests/package/all_headers.cpp"],
    copts = ["-std=c++%d" % standard],
    local_defines = ["CF_CONSUMER_STANDARD=%d" % standard],
    deps = [":cf"],
) for standard in [20, 23]]

test_suite(
    name = "native_tests",
    tests = [":native_%s_test" % name for name in NATIVE_SUITES] +
            [":headers_cxx20_test", ":headers_cxx23_test"],
)

js_test(
    name = "node_toolchain_test",
    entry_point = "tests/toolchains/node.mjs",
    data = [
        ":spike",
        ":node_modules/esbuild",
        ":node_modules/jsonc-parser",
        ":node_modules/miniflare",
    ],
)
