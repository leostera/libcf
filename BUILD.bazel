load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools:worker.bzl", "bridge_spike", "cf_worker")

npm_link_all_packages(name = "node_modules")

cc_library(
    name = "cf",
    hdrs = glob(["include/cf/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "worker_runtime",
    srcs = ["src/worker.cpp"],
    copts = ["-O2", "-fexceptions", "-sDISABLE_EXCEPTION_CATCHING=1"],
    deps = [":cf"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "host_library",
    srcs = ["lib/emscripten-host.js"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runtime_modules",
    srcs = glob(["lib/*.mjs", "lib/*.js"]),
    visibility = ["//visibility:public"],
)

EXAMPLES = [
    "core", "kv", "d1", "r2", "cache", "service", "durable", "events",
    "websocket", "email", "rate-limit", "analytics", "metadata", "worker-loader",
    "crypto", "benchmark", "http-client", "pipeline", "timer", "workflow",
    "images", "clock", "rpc",
]

[cf_worker(name = name, srcs = ["examples/%s/src/main.cpp" % name]) for name in EXAMPLES]
cf_worker(name = "durable-object", srcs = ["examples/durable/src/object.cpp"])
bridge_spike(name = "spike")

filegroup(
    name = "all_workers",
    srcs = [":" + name for name in EXAMPLES] + [":durable-object", ":spike"],
)

js_binary(
    name = "bundle_tool",
    entry_point = "scripts/bundle-worker.mjs",
    data = [":node_modules/esbuild"],
)

[js_run_binary(
    name = name + "_bundle",
    tool = ":bundle_tool",
    srcs = ["examples/%s/worker.mjs" % name, ":runtime_modules", ":" + name] +
           ([":durable-object"] if name == "durable" else []),
    args = ["examples/%s/worker.mjs" % name, "bundles/" + name],
    out_dirs = ["bundles/" + name],
) for name in EXAMPLES]

JS_ENTRIES = {
    "hello": "examples/hello/worker.mjs",
    "hello-js": "examples/hello/plain.mjs",
    "benchmark-js": "examples/benchmark/plain.mjs",
    "service-upstream": "examples/service/upstream/worker.mjs",
    "http-upstream": "examples/http-client/upstream/worker.mjs",
    "rpc-reference": "examples/rpc/reference/worker.mjs",
}

[js_run_binary(
    name = name + "_bundle",
    tool = ":bundle_tool",
    srcs = [entry] + ([":spike"] if name == "hello" else []),
    args = [entry, "bundles/" + name],
    out_dirs = ["bundles/" + name],
) for name, entry in JS_ENTRIES.items()]

filegroup(
    name = "all_bundles",
    srcs = [":" + name + "_bundle" for name in EXAMPLES + JS_ENTRIES.keys()],
)

js_test(
    name = "bundles_test",
    entry_point = "tests/toolchains/bundles.mjs",
    data = [":all_bundles", ":node_modules/miniflare"],
)

filegroup(
    name = "example_sources",
    srcs = glob(["examples/**/*.mjs", "examples/**/*.jsonc", "examples/**/public/**"]),
)

js_test(
    name = "core_local_test",
    entry_point = "examples/core/test/worker.test.mjs",
    data = [
        ":core",
        ":runtime_modules",
        ":example_sources",
        ":node_modules/esbuild",
        ":node_modules/jsonc-parser",
        ":node_modules/miniflare",
    ],
)

NATIVE_SUITES = [
    "core", "storage", "d1", "events", "websocket", "email", "rate_limit",
    "analytics", "metadata", "worker_loader", "subtle_crypto", "http_client",
    "pipeline", "timer", "workflow", "images", "clock", "wire_limits", "rpc",
]

[cc_test(
    name = "native_%s_test" % name,
    srcs = ["tests/native/%s.cpp" % name],
    deps = [":cf"],
) for name in NATIVE_SUITES]

test_suite(
    name = "native_tests",
    tests = [":native_%s_test" % name for name in NATIVE_SUITES],
)

js_test(
    name = "node_toolchain_test",
    entry_point = "tests/toolchains/node.mjs",
    data = [
        ":spike",
        ":node_modules/esbuild",
        ":node_modules/jsonc-parser",
        ":node_modules/miniflare",
    ],
)
